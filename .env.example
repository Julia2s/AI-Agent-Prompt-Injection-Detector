APP_NAME=AI Agent Prompt Injection Detector
APP_VERSION=0.1.0
DEBUG=false
# Compose supplies DB_HOST=db. For running the app outside Docker, use localhost
# and publish PostgreSQL port explicitly if required.
DB_HOST=db
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=detector_db
# These defaults are for localhost coursework only.
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=local-mlflow-password
MLFLOW_DB_NAME=mlflow
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
INFERENCE_DELAY=0.5
