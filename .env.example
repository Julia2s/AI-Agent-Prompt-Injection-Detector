# --- app ---
APP_NAME=AI Agent Prompt Injection Detector
APP_VERSION=0.1.0
DEBUG=false

# --- broker / db (Compose supplies these to all services) ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/detector_db

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_NAME=prompt-injection-detector
MODEL_ALIAS=champion

# --- pipeline topology ---
# Queue size changes require a new QUEUE_NAME or an empty queue recreated manually.
QUEUE_NAME=inference_queue_v2
QUEUE_CAPACITY=50
WORKER_CONCURRENCY=1
PREFETCH_COUNT=1
MAX_ATTEMPTS=3

# --- timings (see README, sections 3-5) ---
INFERENCE_DELAY=0.5
RETRY_DELAY=0.5
PUBLISH_TIMEOUT=1.0
SOURCE_BACKOFF_MAX=2.0
# How long a stopping worker waits for ALREADY ACCEPTED messages. Must be a real
# number (None == do not wait) and below docker's stop_grace_period (10m).
GRACEFUL_TIMEOUT=300

# --- DB credentials (used by docker-compose to build DATABASE_URL) ---
DB_USER=user
DB_PASSWORD=password
DB_NAME=detector_db

# --- MLflow backend DB (used by docker-compose for the mlflow service) ---
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=local-mlflow-password
MLFLOW_DB_NAME=mlflow
